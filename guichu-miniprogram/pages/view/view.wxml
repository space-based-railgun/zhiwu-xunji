<view class="page">
  <view class="h1">{{title}}</view>
  <view class="card" style="margin-top: 20rpx">
    <view class="rrow" wx:for="{{rows}}" wx:key="key" bindtap="onJump" data-room="{{item.roomId}}" data-c="{{item.cid}}" data-item="{{item.itemId}}">
      <view class="ricon">{{item.icon}}</view>
      <view class="rmain">
        <view class="t">{{item.name}} <text class="chip c-orange" wx:if="{{item.warn}}">{{item.warn}}</text></view>
        <view class="s">{{item.sub}}</view>
      </view>
      <view class="chev" wx:if="{{!item.isGroup}}">›</view>
    </view>
    <view class="empty" wx:if="{{!rows.length}}">没有关联内容</view>
  </view>
  <view class="rowbtns" wx:if="{{type === 'zone'}}">
    <view class="btn btn-danger" bindtap="onDelZone">删除分区（不删物品）</view>
  </view>
  <view class="rowbtns" wx:if="{{type === 'trip'}}">
    <view class="btn btn-danger" bindtap="onDelEvent">删除日程</view>
  </view>
  <block wx:if="{{type === 'box'}}">
    <view class="rowbtns">
      <view class="btn btn-primary" bindtap="onUnpack">✓ 确认开箱 · 恢复原位</view>
      <view class="btn" bindtap="onCopyList">复制清单</view>
    </view>
    <view class="note">小打印机前用「复制清单」粘贴到备忘/电脑打印。</view>
  </block>
</view>
