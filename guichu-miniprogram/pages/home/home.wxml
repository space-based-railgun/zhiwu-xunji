<include src="../common/navbar.wxml"/>
<view class="page" style="padding-top: {{navPad}}px">
  <view class="row" style="justify-content: space-between; margin-top: 16rpx">
    <view>
      <view class="h1">我的物品 👋</view>
      <view class="sub">{{sceneName}} · {{roomCount}} 个房间 · {{itemCount}} 件物品</view>
    </view>
    <view class="row" style="gap: 12rpx">
      <view class="btn btn-sm" bindtap="onSwitchUser">
        <image wx:if="{{curUser.avatar}}" class="ava-mini" src="{{curUser.avatar}}" />
        <text wx:else>{{curUser.emoji}}</text>
        <text> {{curUser.name}} ▾</text>
      </view>
      <navigator url="/pages/settings/settings" open-type="switchTab"><view class="btn btn-sm">⚙️ 设置</view></navigator>
    </view>
  </view>

  <view class="card" wx:if="{{guideTasks.length}}" style="margin-top: 20rpx">
    <view class="row" style="justify-content: space-between">
      <view class="h2" style="margin: 0">🧭 新手上路 · {{guideDone}}/4</view>
      <view class="linkbtn" style="color: var(--g-text2); font-size: 23rpx" bindtap="onGuideHide">收起</view>
    </view>
    <view class="rrow" wx:for="{{guideTasks}}" wx:key="id" bindtap="onGuideStep" data-type="{{item.type}}">
      <view class="ricon">{{item.done ? '✅' : item.icon}}</view>
      <view class="rmain"><view class="t">{{item.label}}</view><view class="s">{{item.desc}}</view></view>
      <view class="btn btn-sm {{item.done ? '' : 'btn-primary'}}">{{item.done ? '已完成' : '去完成'}}</view>
    </view>
    <view class="linkbtn" style="color: var(--g-brand); font-size: 23rpx; padding-top: 10rpx" bindtap="onGuideOpen">📖 查看完整新手指南</view>
  </view>

  <view class="scrollx" style="margin-top: 20rpx">
    <view wx:for="{{scenes}}" wx:key="id" class="qchip {{item.active ? 'active' : ''}}" style="display: inline-flex" data-s="{{item.id}}" bindtap="onScene">{{item.emoji}} {{item.name}}{{item.n ? ' · ' + item.n + '房' : ' · 待添加'}}</view>
    <view class="qchip" style="display: inline-flex" bindtap="onSceneAdd">＋ 住址</view>
  </view>

  <view class="searchbar" style="margin-top: 20rpx">
    <input placeholder="搜：护照在哪？yaoshi 也行…" value="{{q}}" bindinput="onInput" bindconfirm="onGo" focus="{{searchFocus}}" />
    <view class="go" bindtap="onGo">→</view>
  </view>
  <view class="chiprow" style="margin-top: 16rpx">
    <view class="qchip" bindtap="onQuick" data-q="护照在哪">护照在哪</view>
    <view class="qchip" bindtap="onQuick" data-q="充电的东西">充电的东西</view>
    <view class="qchip" bindtap="onQuick" data-q="感冒药">感冒药</view>
    <view class="qchip" bindtap="onQuick" data-q="yaoshi">yaoshi</view>
  </view>

  <view class="card" wx:if="{{searchOpen}}" style="margin-top: 20rpx">
    <view class="row" style="justify-content: space-between"><view class="h2" style="margin: 0">搜索结果</view><view class="btn btn-sm" bindtap="closeSearch">收起</view></view>
    <view class="rrow" wx:if="{{zoneHit}}" bindtap="onZone" data-id="{{zoneHit.id}}">
      <view class="ricon">{{zoneHit.emoji}}</view>
      <view class="rmain"><view class="t">分区 · {{zoneHit.name}}</view><view class="s">跨房间聚合 · {{zoneHit.n}} 个收纳点</view></view>
    </view>
    <view class="empty" wx:if="{{!results.length && !zoneHit}}">没有找到，换个说法试试</view>
    <view class="rrow" wx:for="{{results}}" wx:key="itemId" bindtap="onResultFly" data-room="{{item.roomId}}" data-c="{{item.cid}}" data-item="{{item.itemId}}">
      <view class="rmain">
        <view class="t">{{item.name}}</view>
        <view class="s">📍 {{item.room}} · {{item.c}}{{item.why ? ' · ' + item.why : ''}}</view>
        <view class="chiprow"><view class="chip {{c.cls}}" wx:for="{{item.chips}}" wx:for-item="c" wx:key="t">{{c.t}}</view></view>
      </view>
      <view class="btn btn-sm btn-primary">看实景</view>
    </view>
  </view>

  <view class="h2">主动提醒 · 共 {{total}} 条</view>
  <view class="card">
    <view class="rrow" wx:if="{{dueLine}}" bindtap="onDueTap" data-room="{{dueLine.roomId}}" data-c="{{dueLine.cid}}" data-item="{{dueLine.itemId}}">
      <view class="ricon">⏰</view>
      <view class="rmain"><view class="t">{{dueLine.name}} · {{dueLine.due}}</view><view class="s">{{dueLine.where}}</view></view>
      <view class="chev">›</view>
    </view>
    <view class="rrow" wx:if="{{lentLine}}" bindtap="onDueTap" data-room="{{lentLine.roomId}}" data-c="{{lentLine.cid}}" data-item="{{lentLine.itemId}}">
      <view class="ricon">🤝</view>
      <view class="rmain"><view class="t">{{lentLine.name}}</view><view class="s">{{lentLine.where}}</view></view>
      <view class="chev">›</view>
    </view>
    <view class="rrow" wx:if="{{isHome}}" bindtap="onGeo">
      <view class="ricon">📍</view>
      <view class="rmain"><view class="t">防忘带 · 出门必带清单</view><view class="s">出门前打勾确认：钥匙、工牌、雨伞</view></view>
    </view>
    <navigator url="/pages/remind/remind" open-type="switchTab"><view class="linkbtn" style="color: var(--g-brand); font-size: 23rpx; padding-top: 10rpx">查看全部 {{total}} 条 →</view></navigator>
  </view>

  <block wx:if="{{isHome}}">
    <view class="row" style="justify-content: space-between; margin-top: 30rpx">
      <view class="h2" style="margin: 0">本周日程 · 自动备物</view>
      <view class="linkbtn" style="color: var(--g-brand); font-size: 23rpx" bindtap="onEventAdd">＋ 日程</view>
    </view>
    <view class="card">
      <view class="rrow" wx:for="{{events}}" wx:key="id" bindtap="onEvent" data-id="{{item.id}}">
        <view class="ricon">{{item.emoji}}</view>
        <view class="rmain"><view class="t">{{item.title}}</view><view class="s">{{item.date}} · 点击生成携带清单</view></view>
        <view class="chev">›</view>
      </view>
    </view>

    <view class="row" style="justify-content: space-between; margin-top: 30rpx">
      <view class="h2" style="margin: 0">逻辑分区</view>
      <view class="linkbtn" style="color: var(--g-brand); font-size: 23rpx" bindtap="onZoneAdd">＋ 分区</view>
    </view>
    <view class="chiprow" style="margin-bottom: 8rpx">
      <view class="qchip" wx:for="{{zones}}" wx:key="id" bindtap="onZone" data-id="{{item.id}}">{{item.emoji}} {{item.name}} · {{item.n}}件</view>
    </view>
  </block>

  <view class="row" style="justify-content: space-between; margin-top: 30rpx">
    <view class="h2" style="margin: 0">{{sceneName}}</view>
    <view class="row" style="gap: 18rpx">
      <view class="linkbtn" style="color: var(--g-brand); font-size: 23rpx" wx:if="{{isHome}}" bindtap="onPack">📦 搬家打包</view>
      <view class="linkbtn" style="color: var(--g-brand); font-size: 23rpx" bindtap="onRoomAdd">＋ 房间</view>
    </view>
  </view>
  <view class="roomgrid">
    <view class="roomcard" wx:for="{{rooms}}" wx:key="id" bindtap="onRoom" data-id="{{item.id}}">
      <image class="rimg" wx:if="{{item.img}}" src="{{item.img}}" mode="aspectFill" />
      <view class="rshade"></view>
      <view class="rlabel"><view class="rt">{{item.name}}</view><view class="rs">{{item.cs}} 个收纳点 · {{item.n}} 件</view></view>
    </view>
    <view class="roomadd" bindtap="onRoomAdd">＋ 添加房间</view>
  </view>
</view>
